# Backend environment variables
# Copy to `backend/.env` for local development.

PORT=8080
NODE_ENV=development
DATABASE_URL=backend/data/grantflow.dev.db

ADMIN_TOKEN=dev-admin-token
ADMIN_NAME=Local Admin
ADMIN_EMAIL=admin@grantflow.local

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ANYA_ADMIN_TOKEN=anya-dev-token

# Authentication configuration
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_EMAIL_CODE_TTL=600
AUTH_EMAIL_RESEND_SECONDS=45
AUTH_PHONE_CODE_TTL=600
AUTH_PHONE_RESEND_SECONDS=60
AUTH_OAUTH_STATE_TTL=600

AUTH_PUBLIC_URL=http://localhost:5173/grantflow
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_FRONTEND_APP_BASE=/grantflow

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Alternatively:
# TWILIO_FROM_NUMBER=+15555551234

# OpenAI (crawlers, enrichment, avatar lookup)
OPENAI_API_KEY=sk-your-openai-key

# OAuth clients
AUTH_GOOGLE_CLIENT_ID=google-client-id
AUTH_GOOGLE_CLIENT_SECRET=google-client-secret
AUTH_FACEBOOK_CLIENT_ID=facebook-client-id
AUTH_FACEBOOK_CLIENT_SECRET=facebook-client-secret
AUTH_YAHOO_CLIENT_ID=yahoo-client-id
AUTH_YAHOO_CLIENT_SECRET=yahoo-client-secret

# Optional observability
LOG_LEVEL=debug
SENTRY_DSN=
ANALYTICS_WRITE_KEY=
