# Backend environment variables
# Copy to `backend/.env` for local development.

PORT=8080
NODE_ENV=development
# DB selection:
# - sqlite (default): set SQLITE_DB_PATH (file path)
# - postgres: set DB_PROVIDER=postgres and DATABASE_URL=postgres://...
DB_PROVIDER=sqlite
SQLITE_DB_PATH=backend/data/grantflow.dev.db
# For postgres:
# DB_PROVIDER=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname
#
# Auto-migrate:
# - default: enabled for sqlite in non-production, disabled elsewhere
DB_AUTO_MIGRATE=false

ADMIN_TOKEN=dev-admin-token
ADMIN_NAME=Local Admin
ADMIN_EMAIL=admin@grantflow.local

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ANYA_ADMIN_TOKEN=anya-dev-token

# Authentication configuration
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_ACCESS_TOKEN_TTL=10800
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_EMAIL_CODE_TTL=600
AUTH_EMAIL_RESEND_SECONDS=45
AUTH_PHONE_CODE_TTL=600
AUTH_PHONE_RESEND_SECONDS=60
AUTH_OAUTH_STATE_TTL=600

AUTH_PUBLIC_URL=http://localhost:5173/grantflow
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_FRONTEND_APP_BASE=/grantflow

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Alternatively:
# TWILIO_FROM_NUMBER=+15555551234

# OpenAI (crawlers, enrichment, avatar lookup, grant matching)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Anya AI assistant capabilities)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Resend (Email service for verification codes)
RESEND_API_KEY=re_your-resend-key
FROM_EMAIL=noreply@yourdomain.com

# Anya Autonomous Operations Configuration
# ==========================================
# Master switch for all autonomous operations
ANYA_AUTONOMOUS_ENABLED=false

# When to run autonomous operations
ANYA_RUN_ON_STARTUP=false        # Run when server starts
ANYA_RUN_ON_ADMIN_LOGIN=false    # Run when admin logs in
ANYA_RUN_ON_SCHEDULE=false       # Run on schedule (cron)
ANYA_SCHEDULE=0 3 * * *           # Cron schedule (default: 3 AM daily)

# Which operations to run
ANYA_CODE_CRAWL=true              # Scan and fix code issues
ANYA_FUNCTION_TESTS=true          # Test API endpoints
ANYA_CRAWLERS=true                # Run grant crawlers

# Code crawl parameters
ANYA_FIX_CONSOLE=true             # Fix console.log statements
ANYA_FIX_EMPTY_CATCH=true         # Fix empty catch blocks
ANYA_MAX_FILE_CHANGES=20          # Max files to modify per run

# Crawler parameters
ANYA_MATCH_THRESHOLD=80           # Min % match to save to profile (0-100)
ANYA_SAVE_GLOBAL=true             # Save all opportunities globally
ANYA_WAIT_COMPLETION=false        # Wait for crawlers to complete

# Testing parameters
ANYA_FIX_ERRORS=false             # Auto-fix found errors
ANYA_DRY_RUN=false                # Dry run mode (no actual changes)

# OAuth clients
AUTH_GOOGLE_CLIENT_ID=google-client-id
AUTH_GOOGLE_CLIENT_SECRET=google-client-secret
AUTH_FACEBOOK_CLIENT_ID=facebook-client-id
AUTH_FACEBOOK_CLIENT_SECRET=facebook-client-secret
AUTH_YAHOO_CLIENT_ID=yahoo-client-id
AUTH_YAHOO_CLIENT_SECRET=yahoo-client-secret

# Optional observability
LOG_LEVEL=debug
SENTRY_DSN=
ANALYTICS_WRITE_KEY=
