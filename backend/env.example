# Backend environment variables
# Copy to `backend/.env` for local development.

PORT=8080
NODE_ENV=development
# DB selection:
# - sqlite (default): set SQLITE_DB_PATH (file path)
# - postgres: set DB_PROVIDER=postgres and DATABASE_URL=postgres://...
DB_PROVIDER=sqlite
# Local dev (default):
SQLITE_DB_PATH=backend/data/grantflow.dev.db
# Railway production (persistent volume recommended):
# SQLITE_DB_PATH=/mnt/data/grantflow.db
# Safety override (NOT recommended; disables prod fail-fast if SQLITE_DB_PATH isn't on /mnt/data):
# ALLOW_EPHEMERAL_SQLITE=true
# For postgres:
# DB_PROVIDER=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname
#
# Auto-migrate:
# - default: enabled for sqlite in non-production, disabled elsewhere
DB_AUTO_MIGRATE=false

# Startup safety toggles
# - By default, production refuses to auto-seed.
# - You can override specific seed behaviors explicitly if needed.
ENABLE_MIN_NATIONAL_ENSURE=false
ENABLE_ASSISTANCE_DIRECTORIES_SEED=false

## Admin token used for legacy admin-token auth paths (primarily local/dev tooling).
## SECURITY: no default. Set a strong random value explicitly for local use.
## Example (PowerShell): $env:ADMIN_TOKEN = [guid]::NewGuid().ToString()
ADMIN_TOKEN=
ADMIN_NAME=Local Admin
ADMIN_EMAIL=admin@grantflow.local
BULK_POPULATE_KEY=
ALLOW_LEGACY_PROFILE_TOKEN=false

# Uploads
# In production (Railway) mount a persistent volume and point this at it, e.g. /data/uploads.
# This prevents user uploads (avatars, documents, etc.) from being lost on redeploy.
UPLOADS_DIR=

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://app.axiombiolabs.org,https://www.axiombiolabs.org
ANYA_ADMIN_TOKEN=anya-dev-token

# Optional bulk automation key (protects high-impact endpoints like bulk population/crawls)
# Set this in production if you run automated crawls or bulk jobs.
# BULK_POPULATE_KEY=your-strong-random-bulk-key

# Optional geo datasets (if you have custom files); otherwise we fall back to `zipcodes`.
GEO_ZIP_COORDINATES_PATH=
GEO_COUNTIES_BY_STATE_PATH=

# Outbound HTTP (crawlers, geocoding): Axios respects HTTP_PROXY, HTTPS_PROXY, NO_PROXY.
# If crawlers fail with ENOTFOUND/ETIMEDOUT, ensure no proxy env vars block outbound requests.


# Authentication configuration
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_ACCESS_TOKEN_TTL=10800
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_EMAIL_CODE_TTL=600
AUTH_EMAIL_RESEND_SECONDS=45
AUTH_PHONE_CODE_TTL=600
AUTH_PHONE_RESEND_SECONDS=60
AUTH_OAUTH_STATE_TTL=600

AUTH_PUBLIC_URL=http://localhost:5173/grantflow
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_FRONTEND_APP_BASE=/grantflow

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Alternatively:
# TWILIO_FROM_NUMBER=+15555551234

# OpenAI (crawlers, enrichment, avatar lookup, grant matching)
OPENAI_API_KEY=sk-your-openai-key

# Stripe (Services checkout + webhook)
# - Webhook signature verification is REQUIRED.
# - Never log these secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Test-only: allows offline checkout session creation (no network).
# STRIPE_MOCK=true

# Anthropic (Anya AI assistant capabilities)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Resend (Email service for verification codes)
RESEND_API_KEY=re_your-resend-key
FROM_EMAIL=noreply@yourdomain.com

# Ops notifications (login / OTP)
# - Sends an admin alert email on OTP send + successful sign-in.
# - Never includes the OTP code.
AUTH_NOTIFY_ON_LOGIN=true
# Optional override destination; defaults to ADMIN_EMAIL
# AUTH_NOTIFY_EMAIL=ops@yourdomain.com

# Security hardening: NEVER return OTP codes in production responses.
# Set to true only for emergency debugging in a controlled environment.
AUTH_ALLOW_PREVIEW_CODE_IN_PROD=false

# Failsafe: Allow admin users to receive preview codes when email delivery fails.
# Only works for users in ADMIN_EMAIL/ADMIN_EMAILS list.
# Does NOT weaken security for non-admin users.
# Set to true if you need to ensure admin can always log in even if email fails.
AUTH_ALLOW_ADMIN_PREVIEW_CODE=false

# Uploads persistence (recommended in production)
# Point this at a mounted persistent volume directory.
# UPLOADS_DIR=/data/uploads

# Baseline seeding (profiles + sections). If seed file is missing, server falls back to designated profiles.
# BASELINE_SEED_MODE=auto   # auto|force|off

# Anya Autonomous Operations Configuration
# ==========================================
# Master switch for all autonomous operations
ANYA_AUTONOMOUS_ENABLED=false

# When to run autonomous operations
ANYA_RUN_ON_STARTUP=false        # Run when server starts
ANYA_RUN_ON_ADMIN_LOGIN=false    # Run when admin logs in
ANYA_RUN_ON_SCHEDULE=false       # Run on schedule (cron)
ANYA_SCHEDULE=0 3 * * *           # Cron schedule (default: 3 AM daily)

# Daily profile-aware funding discovery (uses triggerAutoDiscoveryCrawlers per active profile).
# Independent of ANYA_AUTONOMOUS_* — enable this for once-a-day background crawls aligned to profile needs.
AUTO_DISCOVERY_DAILY_ENABLED=false
AUTO_DISCOVERY_DAILY_HOUR=3       # Local server hour to run (default: 3 AM)

# Admin login: nationwide geo ZIP crawl (sequential states inside one job). Independent of ANYA_AUTONOMOUS_*.
ANYA_ADMIN_GEO_ON_LOGIN=true
# Min hours between full sweeps (0 = allow every login if no job is running — not recommended)
ANYA_ADMIN_GEO_COOLDOWN_HOURS=24
# Pause between finishing one state and starting the next (ms) to reduce burst load
ANYA_ADMIN_GEO_STATE_PACING_MS=2000
# Skip heavy domain-corpus phase on these sweeps (recommended true)
ANYA_ADMIN_GEO_SKIP_DOMAIN_CORPUS=true

# Which operations to run
ANYA_CODE_CRAWL=true              # Scan and fix code issues
ANYA_FUNCTION_TESTS=true          # Test API endpoints
ANYA_CRAWLERS=true                # Run grant crawlers

# Code crawl parameters
ANYA_FIX_CONSOLE=true             # Fix console.log statements
ANYA_FIX_EMPTY_CATCH=true         # Fix empty catch blocks
ANYA_MAX_FILE_CHANGES=20          # Max files to modify per run
# Anya code-error repair writes are controlled per invocation:
# CLI --write or HTTP dry_run=false. Applied edits are backed up and audited.

# Crawler parameters
# DEPRECATED / INERT: ANYA_MATCH_THRESHOLD is NOT read anywhere in the code. The
# discovery bar is owned by backend/config/matchThresholds.js (DEFAULT_MIN_SCORE,
# need-anchored standard = 25). To tighten the bar, set GRANTFLOW_DISCOVERY_MIN_SCORE
# (clamped to [25, 100] — it can raise the bar but never drop below the 25 floor).
# ANYA_MATCH_THRESHOLD=80         # legacy, ignored — kept only for reference
# GRANTFLOW_DISCOVERY_MIN_SCORE=25  # optional override; must be >= 25
ANYA_SAVE_GLOBAL=true             # Save all opportunities globally
ANYA_WAIT_COMPLETION=false        # Wait for crawlers to complete

# Testing parameters
ANYA_FIX_ERRORS=false             # Auto-fix found errors
ANYA_DRY_RUN=false                # Dry run mode (no actual changes)

# OAuth clients
AUTH_GOOGLE_CLIENT_ID=google-client-id
AUTH_GOOGLE_CLIENT_SECRET=google-client-secret
AUTH_FACEBOOK_CLIENT_ID=facebook-client-id
AUTH_FACEBOOK_CLIENT_SECRET=facebook-client-secret
AUTH_YAHOO_CLIENT_ID=yahoo-client-id
AUTH_YAHOO_CLIENT_SECRET=yahoo-client-secret

# Optional observability
LOG_LEVEL=debug
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
ANALYTICS_WRITE_KEY=
