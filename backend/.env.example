## GrantFlow (backend) environment variables
## Copy to `backend/.env.development.local` (recommended) or `backend/.env` and adjust.

PORT=8080
NODE_ENV=development
DATABASE_URL=backend/data/grantflow.dev.db

# Dev-only admin token for local smoke/doctor.
ADMIN_TOKEN=dev-admin-token
ADMIN_NAME=Local Admin
ADMIN_EMAIL=admin@grantflow.local

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Auth (dev defaults)
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_PUBLIC_URL=http://localhost:5173/grantflow
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_FRONTEND_APP_BASE=/grantflow

# Integrations (leave blank in dev/smoke; backend must degrade gracefully)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# Doctor/smoke mode
SMOKE_MODE=true
ANYA_AUTONOMOUS_ENABLED=false
ANYA_RUN_ON_STARTUP=false
