{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grantflow.local/schemas/eva-result-v1.json",
  "title": "EVA portfolio run result (v1)",
  "description": "Versioned, validated contract for a single EVA edge-runner upload. GrantFlow's evaIngest validates every payload against this before persistence. Signature envelope is transport-level (HTTP headers), not part of this body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "runner_id",
    "started_at",
    "completed_at",
    "environment",
    "apps"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "runner_id": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "environment": { "type": "string", "enum": ["local-windows", "ci", "fixture", "staging"] },
    "runner_version": { "type": "string", "maxLength": 32 },
    "catchup": { "type": "boolean", "description": "true when this run is a wake-from-sleep catch-up for a missed schedule" },
    "apps": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": { "$ref": "#/definitions/appRun" }
    }
  },
  "definitions": {
    "appRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_id", "display_name", "app_status", "duration_ms", "journeys"],
      "properties": {
        "app_id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 64 },
        "display_name": { "type": "string", "maxLength": 128 },
        "repo": { "type": "string", "maxLength": 128 },
        "commit_sha": { "type": "string", "maxLength": 64 },
        "app_status": {
          "type": "string",
          "enum": ["tested", "blocked", "not_run", "startup_failed", "source_unavailable", "runtime_unavailable", "unsafe_to_automate", "manual_required", "not_implemented"]
        },
        "blocker_reason": { "type": "string", "maxLength": 500 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "feature_coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "features_total": { "type": "integer", "minimum": 0 },
            "features_covered": { "type": "integer", "minimum": 0 },
            "unautomated_features": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 200 }
          }
        },
        "journeys": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/journey" } }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_id", "name", "status"],
      "properties": {
        "journey_id": { "type": "string", "pattern": "^[a-z0-9._-]+$", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["passed", "failed", "blocked", "skipped"] },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
        "retry_classification": { "type": "string", "enum": ["reproducible", "intermittent", "environmental", "not-retried"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "route_or_control": { "type": "string", "maxLength": 300 },
        "failure_class": { "type": "string", "maxLength": 80, "description": "Normalized failure class, e.g. console-error, network-5xx, assertion, timeout, overflow, redirect, uncaught-page-error" },
        "error_signature": { "type": "string", "maxLength": 500, "description": "Stable, redacted error signature used in the dedup fingerprint" },
        "expected_behavior": { "type": "string", "maxLength": 1000 },
        "observed_behavior": { "type": "string", "maxLength": 1000 },
        "repro_steps": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 40 },
        "user_impact": { "type": "string", "maxLength": 1000 },
        "likely_root_cause": { "type": "string", "maxLength": 1000 },
        "recommended_fix": { "type": "string", "maxLength": 1000 },
        "candidate_files": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 20 },
        "diagnostic_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "missing_evidence": { "type": "string", "maxLength": 500, "description": "Required when diagnostic_confidence < 0.70: what evidence is missing and the next diagnostic step" },
        "evidence": { "type": "array", "maxItems": 30, "items": { "$ref": "#/definitions/evidenceRef" } }
      },
      "allOf": [
        {
          "$comment": "A failure must carry the diagnostic bundle.",
          "if": { "properties": { "status": { "const": "failed" } } },
          "then": { "required": ["severity", "retry_classification", "failure_class", "expected_behavior", "observed_behavior", "repro_steps", "user_impact", "diagnostic_confidence"] }
        }
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["trace", "screenshot", "video", "console", "network", "server-log", "steps", "timing"] },
        "ref": { "type": "string", "maxLength": 400, "description": "Opaque, sanitized storage reference (id or relative path) — never a full private Windows path, token, or raw log body" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
