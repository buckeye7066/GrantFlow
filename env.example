# Frontend (Vite) environment variables
# Copy to `.env` and adjust as needed.

VITE_API_URL=http://localhost:8080
VITE_APP_BASE=/grantflow

# Optional: onboarding video URL/path. If unset, UI attempts `public/Grant Flow_ Get Started. mp4`.
# Examples:
# - VITE_ONBOARDING_VIDEO_URL=/Grant%20Flow_%20Get%20Started.%20mp4
# - VITE_ONBOARDING_VIDEO_URL=https://cdn.example.com/grantflow/onboarding.mp4
VITE_ONBOARDING_VIDEO_URL=

# Optional observability hooks
# VITE_ANALYTICS_WRITE_KEY=GF_DEV_ANALYTICS_KEY
# VITE_SENTRY_DSN=https://user@sentry.io/project
