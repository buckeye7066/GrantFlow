{
  "name": "grant-flow",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "overrides": {
    "fast-xml-parser": "$fast-xml-parser",
    "shell-quote": ">=1.9.0",
    "nanoid": "^3.3.18",
    "js-yaml": "5.2.3",
    "@eslint/config-array": "^0.23.5",
    "eslint": {
      "minimatch": "^10.2.5"
    },
    "@eslint/eslintrc": {
      "minimatch": "^10.2.5",
      "js-yaml": "4.3.1"
    },
    "eslint-plugin-react": {
      "minimatch": "^10.2.5"
    },
    "@capacitor/cli": {
      "xcode": {
        "uuid": "11.1.1"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/ensure-build-natives.mjs",
    "build": "vite build",
    "postbuild": "node scripts/build-mobile-bundle.mjs",
    "build:mobile-bundle": "npm run build",
    "quality:gate": "node scripts/code-quality-gate.mjs",
    "quality:report": "node scripts/code-quality-gate.mjs --report",
    "metadata:audit": "node scripts/audit-section-metadata.mjs",
    "check:profile-metadata": "node scripts/audit-section-metadata.mjs",
    "lint": "eslint --max-warnings 0 \"src/**/*.{js,jsx}\" \"backend/**/*.js\" \"shared/**/*.js\" \"tests/unit/**/*.mjs\"",
    "lint:strict": "eslint --max-warnings 0 \"src/**/*.{js,jsx}\" \"backend/**/*.js\" \"shared/**/*.js\"",
    "auth-middleware:check": "node scripts/check-auth-middleware.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "profile-guards:check": "node scripts/check-profile-guard-reexports.mjs",
    "runtime-imports:check": "node scripts/check-runtime-imports.mjs",
    "check:env-examples": "node scripts/check-env-examples.mjs",
    "check:prepush": "npm run auth-middleware:check && npm run profile-guards:check && npm run check:profile-metadata && npm run runtime-imports:check && npm run check:env-examples && npm run lint && npm run typecheck && npm run build",
    "unit": "node scripts/run-unit-tests.mjs && node scripts/run-vitest-isolated.mjs run --exclude \"backend/tests/otp*.test.js\" --exclude \"backend/tests/emailOtpTokenNoVerifier.test.js\" && node scripts/run-vitest-isolated.mjs run --no-file-parallelism backend/tests/otp backend/tests/emailOtpTokenNoVerifier",
    "test:endpoints": "node scripts/run-vitest-isolated.mjs run --config vitest.endpoints.config.js",
    "smoke": "node ./node_modules/playwright/cli.js test -c tests/smoke/playwright.config.mjs",
    "smoke:install": "node ./node_modules/playwright/cli.js install chromium",
    "e2e": "node ./node_modules/playwright/cli.js test -c tests/e2e/playwright.config.mjs",
    "e2e:install": "npm run smoke:install",
    "doctor": "node scripts/doctor.mjs",
    "dns:godaddy:vercel": "node ./scripts/godaddy-set-vercel-dns.mjs",
    "smoke:apply-engine": "node backend/scripts/smoke-apply-engine.mjs",
    "test": "npm run check:profile-metadata && npm run lint:ci && npm run typecheck && npm run build && npm run unit",
    "test:all": "npm run test && npm run smoke:install && npm run smoke && npm run e2e",
    "preview": "vite preview",
    "backend": "node backend/start.js",
    "dev:full": "concurrently \"npm run backend\" \"npm run dev\"",
    "dev:all": "npm run dev:full",
    "ingest": "node scripts/ingest.mjs",
    "ingest:grantsgov": "node scripts/ingest-grantsgov.mjs",
    "ingest:usaspending": "node scripts/ingest-usaspending.mjs",
    "migrate": "node backend/db/migrate.js",
    "db:check": "node scripts/db-check.mjs",
    "safe-sql:check": "node scripts/codemod/safe-sql.mjs",
    "profile-scope:check": "node scripts/codemod/no-unscoped-profile-query.mjs",
    "lint:ci": "eslint --max-warnings 0 \"src/**/*.{js,jsx}\" \"backend/**/*.js\" \"shared/**/*.js\" \"tests/unit/**/*.mjs\"",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "deployment-config:check": "node scripts/check-deployment-config.mjs",
    "seed:deterministic": "node backend/scripts/seed-deterministic.mjs",
    "db:setup": "npm run migrate && npm run seed:deterministic",
    "smoke:login": "node ./scripts/smoke-login.mjs",
    "smoke:callback": "node ./scripts/smoke-auth-callback.mjs",
    "smoke:auth-refresh": "node ./scripts/smoke-auth-refresh.mjs",
    "smoke:auth-diagnostics": "node ./scripts/smoke-auth-diagnostics.mjs",
    "smoke:org-profile": "node ./scripts/smoke-organization-profile.mjs",
    "smoke:prod": "node ./scripts/smoke-prod-readonly.mjs",
    "smoke:mission": "node ./scripts/smoke-grantflow-mission.mjs",
    "check:profiles": "node ./scripts/check-profiles.mjs",
    "seed:profiles": "node ./scripts/seed-profiles.mjs",
    "seed:db": "node ./scripts/build-seed-db.mjs",
    "seed:demo": "node ./scripts/seed-real-opportunities.mjs",
    "crawl:nationwide": "node ./scripts/nationwide-comprehensive-crawl.mjs",
    "crawl:targeted": "node ./scripts/extended-state-crawler.mjs",
    "prepopulate:grants": "node ./scripts/prepopulate-profile-grants.mjs",
    "setup:production": "bash ./scripts/setup-production-db.sh",
    "start": "node backend/start.js",
    "crawler:smoke": "node ./scripts/crawler-smoke.mjs",
    "crawler:run": "node ./scripts/crawler-run.mjs",
    "crawler:doctor": "node backend/crawler-os/scripts/doctor.mjs",
    "crawler:verify": "node ./scripts/crawler-system-verify.mjs",
    "crawler-os:test": "node --test backend/crawler-os/tests/*.test.mjs",
    "crawler-os:lint": "node backend/crawler-os/scripts/lint.mjs",
    "crawler-os:crawl": "node scripts/crawler-os-crawl.mjs",
    "crawler-os:backfill": "node backend/scripts/crawler-os-backfill.mjs",
    "opps:check-national-minimum": "node backend/crawler-os/scripts/checkNationalMinimum.mjs",
    "opps:ensure-national-minimum": "node ./scripts/opportunities-national-minimum.mjs ensure",
    "opps:backfill": "node ./scripts/backfill-opportunity-fields.mjs",
    "migrate:data": "node backend/scripts/migrate-sqlite-to-postgres.mjs",
    "test:keys": "node backend/scripts/test-keys.js",
    "test:auto-merge": "node ./scripts/test-auto-merge-workflow.mjs",
    "merge:all-branches": "node ./scripts/merge-all-branches.mjs",
    "geo:crawl": "node ./scripts/run-geocrawl-all-zips.mjs",
    "geo:dev-start": "node ./scripts/dev-start-geo-crawl.mjs",
    "release:gates": "node ./scripts/release-gates.mjs",
    "crawler:profile-proof": "node ./scripts/crawler-profile-routing-proof.mjs",
    "crawler:profile-proof:write": "node ./scripts/crawler-profile-routing-proof.mjs --write",
    "production:proof": "npm run crawler:profile-proof && node ./scripts/production-readiness-smoke.mjs",
    "production:deploy-proof": "node ./scripts/production-deployment-proof.mjs",
    "production:deploy-proof:write": "node ./scripts/production-deployment-proof.mjs --write",
    "purge:regional": "node backend/scripts/regional-purge.mjs",
    "amy:train": "node ./scripts/amy-train.mjs",
    "acceptance:amy-parity": "node ./scripts/grantflow-acceptance-50.mjs",
    "amy:cleanup": "node ./scripts/amy-cleanup.mjs"
  },
