# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/
test-results/
artifacts/
playwright-report/
blob-report/
traces/
.nyc_output/

# Local env files — NEVER commit secrets or credentials to the repository.
# If .env or .env.* files were previously tracked, remove them with:
#   git rm --cached .env .env.anya
.env
.env.*
!.env.example

# Vercel
.vercel/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Runtime test / server logs produced by local runs; keep out of the repo.
e2e-backend.log
e2e-backend.err.log
test-runner.log
test-via-npm.log
# Catch-all for ad-hoc local run logs (browser-test2.log, btest.log,
# unit-out.log, etc.) so they never clutter the working tree.
*.log
# Self-test / readiness logs written by Sam and other background agents.
docs/_readiness_logs/

# Runtime audit output from Anya / background services.
audit-reports/

# Nested public-audit clone of the project (its own git repo); must never be
# committed into the main repo as a nested repo / accidental submodule.
GrantFlow-public-audit/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
.cursor/
# Keep shared Cursor rules in-repo so agent behavior (mission goals,
# auto-push-fixes, etc.) persists across clones and contributors.
!.cursor/
!.cursor/rules/
!.cursor/rules/*.mdc
.cursor/*
!.cursor/rules/
# Keep Impeccable design skills in-repo so the tooling travels with the project
# (installed via `impeccable skills install`). Negation must follow `.cursor/*`.
!.cursor/skills/
!.cursor/skills/**

# Impeccable runtime/live-session state (machine-local, not tooling)
.impeccable/
.impeccable-live.json
.impeccable-live/
*.suo
*.user

# Databases / runtime data (local only)
backend/data/
seed/*.db
*.db
seed/*.db-shm
seed/*.db-wal
seed/*.db-journal
*.db-shm
*.db-wal
*.db-journal

# Backup files and temporary artifacts
*.bak
tmp/
# Ad-hoc local probe scripts (e.g. .tmp-test-agent-self-heal.mjs).
# These are written to validate a fix end-to-end and deleted after; this
# pattern is the safety net so they never accidentally land in git.
.tmp-*.mjs
.tmp-*.js
.tmp-*.sqlite

# Scratch/debugging tooling produced by codemod or audit passes.
# Anything under scripts/ that starts with `_` is one-off, not shipped.
scripts/_*

# Claude Code agent worktrees — isolated nested checkouts used as agent
# scratch space. Never commit (would nest the repo inside itself).
.claude/worktrees/
# Audit-pass output (audit-scan.json) is a local artifact; the canonical
# audit lives under audit-reports/ above.
audit-scan.json

# User uploads / local artifacts
backend/temp_images/
backend/uploads/
public/*.mp4
# Some mp4 assets in this repo have a space in ". mp4" which doesn't match "*.mp4"
public/*mp4
public/*mp4*

# Allow the onboarding walkthrough video to be committed/deployed.
# The UI expects this exact filename under Vite's base path.
!public/Grant Flow_ Get Started.mp4
!public/Grant Flow_ Get Started. mp4

# Duplicate directories that should not be committed
# The root of the repository is authoritative
GrantFlow-main/
repo/

.vercel

# Never commit real credential routing maps or password exports (secrets)
**/hamilton-routes.local.json
**/*routes.local.json
backend/config/userProfileMappings.local.json
backend/config/designatedProfiles.local.json
**/*Passwords*.csv
**/*passwords*.csv

# Live-editing coordination lock (see .cursor/rules/respect-edit-lock.mdc) — never commit
.agent-edit-lock

# FlexFactor audit scratch lists (intermediate tooling output, not app content)
grantflow_critical_files.txt
grantflow_files_with_defects.txt

# Personal Claude Code overrides (not shared)
CLAUDE.local.md
