# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/
test-results/
artifacts/
playwright-report/
blob-report/
traces/
.nyc_output/

# Local env files — NEVER commit secrets or credentials to the repository.
# If .env or .env.* files were previously tracked, remove them with:
#   git rm --cached .env .env.anya
.env
.env.*
!.env.example

# Vercel
.vercel/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Runtime test / server logs produced by local runs; keep out of the repo.
e2e-backend.log
e2e-backend.err.log
test-runner.log
test-via-npm.log
# Catch-all for ad-hoc local run logs (browser-test2.log, btest.log,
# unit-out.log, etc.) so they never clutter the working tree.
*.log
# Self-test / readiness logs written by Sam and other background agents.
docs/_readiness_logs/

# Runtime audit output from Anya / background services.
audit-reports/

# Nested public-audit clone of the project (its own git repo); must never be
# committed into the main repo as a nested repo / accidental submodule.
GrantFlow-public-audit/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
.cursor/
# Keep shared Cursor rules in-repo so agent behavior (mission goals,
# auto-push-fixes, etc.) persists across clones and contributors.
!.cursor/
!.cursor/rules/
!.cursor/rules/*.mdc
.cursor/*
!.cursor/rules/
*.suo
*.user

# Databases / runtime data (local only)
backend/data/
seed/*.db
*.db
seed/*.db-shm
seed/*.db-wal
seed/*.db-journal
*.db-shm
*.db-wal
*.db-journal

# Backup files and temporary artifacts
*.bak
tmp/

# Scratch/debugging tooling produced by codemod or audit passes.
# Anything under scripts/ that starts with `_` is one-off, not shipped.
scripts/_*
# Audit-pass output (audit-scan.json) is a local artifact; the canonical
# audit lives under audit-reports/ above.
audit-scan.json

# User uploads / local artifacts
backend/temp_images/
backend/uploads/
public/*.mp4
# Some mp4 assets in this repo have a space in ". mp4" which doesn't match "*.mp4"
public/*mp4
public/*mp4*

# Allow the onboarding walkthrough video to be committed/deployed.
# The UI expects this exact filename under Vite's base path.
!public/Grant Flow_ Get Started.mp4
!public/Grant Flow_ Get Started. mp4

# Duplicate directories that should not be committed
# The root of the repository is authoritative
GrantFlow-main/
repo/

.vercel
