# Frontend (Vite) environment variables
# Copy to `.env` and adjust as needed.

VITE_API_URL=http://localhost:8080
VITE_APP_BASE=/grantflow

# Vite dev proxy target (used only by the dev server proxy in vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:8080

# Vite build base path (served at /grantflow in production)
VITE_ASSET_BASE=/grantflow

# Optional observability hooks
# VITE_ANALYTICS_WRITE_KEY=GF_DEV_ANALYTICS_KEY
# VITE_SENTRY_DSN=https://user@sentry.io/project


# Optional Firebase (Firestore) client config
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
