# GrantFlow env example (root)
#
# This file is generated from code references via:
#   node scripts/generate-env-examples.mjs
#
# ---- Frontend (Vite) ----
# Vite provides these automatically (do not set in .env):
# - BASE_URL
# - DEV
# - MODE
# - NODE_ENV
# - PROD
# - VERCEL_GIT_COMMIT_SHA

# Configure Vite-exposed variables:
# VITE_ANYA_COPILOT_ENABLED=
# VITE_ANYA_SCREENSHOT_ENABLED=
# VITE_API_URL=
VITE_APP_BASE=/grantflow
