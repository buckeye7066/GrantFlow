# GrantFlow env example (root)
#
# This file is generated from code references via:
#   node scripts/generate-env-examples.mjs
#
# ---- Frontend (Vite) ----
# Vite provides these automatically (do not set in .env):
# - BASE_URL
# - DEV
# - PROD

# Configure Vite-exposed variables:
# VITE_API_URL=
# VITE_APP_BASE sets the BrowserRouter basename for sub-path deployments.
# Must match the Vite `base` config (VITE_ASSET_BASE) without the trailing slash.
# Required for production at axiombiolabs.org/grantflow — set this in Vercel env vars.
VITE_APP_BASE=/grantflow
# VITE_CANONICAL_HOST=
# VITE_CANONICAL_HOST_STRICT=
# VITE_DEV_ADMIN_TOKEN=<REPLACE_ME>
# VITE_FIREBASE_API_KEY=<REPLACE_ME>
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=

# ---- Backend / scripts ----
# NOTE: `npm run backend` loads .env from the repo root.
