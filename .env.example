###############################################
# GrantFlow root .env.example (DEV TEMPLATE)
#
# Copy this file to `.env` for local development.
# - Safe defaults are provided for local-only use.
# - Do NOT use these defaults in production.
###############################################

############################
# Backend (Express)
############################
NODE_ENV=development
PORT=8080

# SQLite DB path (relative or absolute). Backend will create file if missing.
DATABASE_URL=backend/data/grantflow.dev.db

# Admin auth (dev-only). Used for smoke + admin tools bypass.
ADMIN_TOKEN=dev-admin-token
ADMIN_NAME=Local Admin
ADMIN_EMAIL=admin@grantflow.local

# Frontend origin(s) allowed by backend CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Auth (dev-only secret; change for real deployments)
AUTH_JWT_SECRET=dev-secret-change-me

# Optional external services (leave blank for local dev; features will degrade gracefully)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=noreply@grantflow.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Crawler v2 admin/bulk key (used by /api/crawler-v2/run)
BULK_POPULATE_KEY=grantflow-bulk-2026

############################
# Frontend (Vite)
############################
VITE_APP_BASE=/grantflow

# Vite dev proxy target for /api
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional: override API base URL used by the client in dev
VITE_API_URL=http://localhost:8080

# Optional: base path for built assets (leave empty to mirror VITE_APP_BASE)
VITE_ASSET_BASE=/grantflow
