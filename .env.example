# Backend Configuration
ANYA_ADMIN_TOKEN=your-secret-admin-token-here
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Anthropic Claude API Configuration (for Anya AI Assistant)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANYA_CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI API Configuration (deprecated - use Anthropic instead)
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Frontend Configuration
VITE_API_PROXY_TARGET=http://localhost:4000

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual secrets
# 3. Get your Anthropic API key from https://console.anthropic.com/
# 4. The ANYA_CLAUDE_MODEL defaults to claude-sonnet-4-20250514 if not specified
# 5. Never commit .env to version control
# 6. Keep your API keys secure and rotate them regularly
