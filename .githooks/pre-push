#!/usr/bin/env bash
#
# Git pre-push hook that runs lint validation before pushing.
# This helps prevent broken code from being pushed to remote branches.
#
# To enable this hook:
#   git config core.hooksPath .githooks
#
# Or copy to .git/hooks/:
#   cp .githooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push

set -e

echo "╔══════════════════════════════════════════════════════════════╗"
echo "║              Pre-push validation (lint check)                ║"
echo "╚══════════════════════════════════════════════════════════════╝"

# Run ESLint check
echo ""
echo "→ Running ESLint..."
if npx eslint --max-warnings 0 "src/**/*.{js,jsx}" "backend/**/*.js" 2>/dev/null; then
    echo "✓ ESLint passed"
else
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  LINT ERRORS DETECTED - Push blocked                         ║"
    echo "║                                                              ║"
    echo "║  Please fix the lint errors above before pushing.            ║"
    echo "║  You can run 'npm run lint' to see all errors.               ║"
    echo "║  Run 'npx eslint --fix ...' to auto-fix some issues.         ║"
    echo "║                                                              ║"
    echo "║  To bypass this check (not recommended):                     ║"
    echo "║    git push --no-verify                                      ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    exit 1
fi

echo ""
echo "✓ Pre-push validation passed. Proceeding with push..."
