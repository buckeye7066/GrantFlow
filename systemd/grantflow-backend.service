[Unit]
Description=GrantFlow Backend API Service
Documentation=https://github.com/buckeye7066/GrantFlow
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/grantflow
Environment="NODE_ENV=production"
EnvironmentFile=-/var/www/grantflow/.env
ExecStart=/usr/bin/node backend/server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grantflow-backend

[Install]
WantedBy=multi-user.target
