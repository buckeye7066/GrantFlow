{
  "redirects": [
    {
      "source": "/",
      "destination": "/grantflow",
      "permanent": false
    },
    {
      "source": "/grantlfow",
      "destination": "/grantflow",
      "permanent": true
    },
    {
      "source": "/grantlfow/:path*",
      "destination": "/grantflow/:path*",
      "permanent": true
    },
    {
      "source": "/grantflow/:path*",
      "has": [{ "type": "host", "value": "app.axiombiolabs.org" }],
      "destination": "https://www.axiombiolabs.org/grantflow/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://grantflow-production.up.railway.app/api/:path*"
    },
    {
      "source": "/grantflow/api/:path*",
      "destination": "https://grantflow-production.up.railway.app/api/:path*"
    },
    {
      "source": "/grantflow",
      "destination": "/index.html"
    },
    {
      "source": "/grantflow/:path*",
      "destination": "/index.html"
    }
  ]
}
