{
  "redirects": [
    {
      "source": "/",
      "destination": "/grantflow",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/grantflow",
      "destination": "/index.html"
    },
    {
      "source": "/grantflow/:path*",
      "destination": "/index.html"
    }
  ]
}
