{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/grantflow",
      "permanent": false
    },
    {
      "source": "/grantflow/",
      "destination": "/grantflow",
      "permanent": false
    },
    {
      "source": "/grantlfow",
      "destination": "/grantflow",
      "permanent": true
    },
    {
      "source": "/grantlfow/:path*",
      "destination": "/grantflow/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "axiombiolabs.org"
        }
      ],
      "destination": "https://www.axiombiolabs.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/grantflow/Grant%20Flow_%20Get%20Started.mp4",
      "destination": "/Grant Flow_ Get Started.mp4"
    },
    {
      "source": "/grantflow/Grant%20Flow_%20Get%20Started.%20mp4",
      "destination": "/Grant Flow_ Get Started.mp4"
    },
    {
      "source": "/grantflow/Grant Flow_ Get Started.mp4",
      "destination": "/Grant Flow_ Get Started.mp4"
    },
    {
      "source": "/grantflow/Grant Flow_ Get Started. mp4",
      "destination": "/Grant Flow_ Get Started.mp4"
    },
    {
      "source": "/api/:path*",
      "destination": "https://grantflow-production.up.railway.app/api/:path*"
    },
    {
      "source": "/grantflow/api/:path*",
      "destination": "https://grantflow-production.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://grantflow-production.up.railway.app/uploads/:path*"
    },
    {
      "source": "/grantflow/uploads/:path*",
      "destination": "https://grantflow-production.up.railway.app/uploads/:path*"
    },
    {
      "source": "/grantflow/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/grantflow/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/grantflow",
      "destination": "/index.html"
    },
    {
      "source": "/grantflow/",
      "destination": "/index.html"
    },
    {
      "source": "/grantflow/:path*",
      "destination": "/index.html"
    }
  ]
}
