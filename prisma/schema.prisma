// GrantFlow Prisma Schema
// PostgreSQL as the system of record.
// Object storage (S3-compatible or local disk) referenced by rawPayloadRef / uploadedFileRef.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum SourceConnectorType {
  REST_API
  BULK_DOWNLOAD
  RSS_FEED
  XML_FEED
  JSON_FEED
  CSV_FEED
  PUBLIC_PAGE
  LICENSED_API
}

enum AuthType {
  NONE
  API_KEY
  OAUTH2
  BASIC
  BEARER_TOKEN
  AWS_S3
}

enum SyncStrategy {
  FULL_FETCH
  INCREMENTAL_CURSOR
  INCREMENTAL_TIMESTAMP
  POLLING
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNSATISFIED_CREDENTIAL
  DISABLED
}

enum RawFormat {
  JSON
  XML
  CSV
  HTML
  RSS
}

enum ParseStatus {
  PARSED
  SKIPPED
  ERROR
}

enum OpportunityStatus {
  OPEN
  FORECASTED
  RECURRING
  ROLLING
  CLOSED
  CANCELED
  ARCHIVED
}

enum ApplicationMethod {
  ONLINE_PORTAL
  EMAIL
  MAIL
  IN_PERSON
  OTHER
}

enum ChangeType {
  CREATED
  UPDATED
  AMENDED
  STATUS_CHANGE
  DEADLINE_CHANGE
  AWARD_CHANGE
}

enum FunderType {
  FEDERAL_AGENCY
  STATE_AGENCY
  LOCAL_GOVERNMENT
  TRIBAL_NATION
  FOUNDATION
  CORPORATE
  COMMUNITY
  NONPROFIT
  OTHER
}

enum ApplicantType {
  NONPROFIT
  BUSINESS
  INDIVIDUAL
  RESEARCHER
  UNIVERSITY
  FAITH_BASED
  GOVERNMENT_ENTITY
  TRIBAL_NATION
  HEALTHCARE_ORG
  COMMUNITY_GROUP
  ARTIST
  CONSULTANT
  AGENCY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum ApplicationStage {
  PROSPECT
  MATCH
  INTENT
  DRAFTING
  REVIEW
  READY_TO_SUBMIT
  SUBMITTED
  AWARDED
  REJECTED
  CLOSEOUT
  CLOSED
}

enum ApplicationOutcome {
  PENDING
  AWARDED
  REJECTED
  WITHDRAWN
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  NEEDS_REVISION
  REJECTED
}

// ─────────────────────────────────────────────────────────
// Core Auth / Tenant Models
// ─────────────────────────────────────────────────────────

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  users             User[]
  applicantProfiles ApplicantProfile[]
  applications      Application[]
  savedSearches     SavedSearch[]
  knowledgeAssets   KnowledgeAsset[]
  tasks             Task[]
  auditLogs         AuditLog[]
}

model User {
  id              String   @id @default(cuid())
  tenantId        String
  email           String
  hashedPassword  String
  displayName     String?
  role            UserRole  @default(VIEWER)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([tenantId])
  @@index([email])
}

// ─────────────────────────────────────────────────────────
// Source Connectors & Raw Records
// ─────────────────────────────────────────────────────────

model SourceConnector {
  id                          String   @id @default(cuid())
  name                        String
  sourceType                  SourceConnectorType
  authType                    AuthType                  @default(NONE)
  requiredCredentialKey       String?
  isCredentialSatisfied       Boolean  @default(false)
  baseUrl                     String
  rateLimitPerMin             Int?
  syncStrategy                SyncStrategy             @default(FULL_FETCH)
  checkpointCursor            String?
  lastSuccessfulSyncAt        DateTime?
  lastError                   String?
  healthStatus                HealthStatus             @default(DISABLED)
  enabled                     Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  rawRecords   RawSourceRecord[]
  opportunities Opportunity[]

  @@index([healthStatus])
  @@index([enabled])
}

model RawSourceRecord {
  id              String   @id @default(cuid())
  connectorId     String
  externalId      String
  fetchedAt       DateTime @default(now())
  contentHash     String
  rawFormat       RawFormat
  rawPayloadRef   String
  parseStatus     ParseStatus @default(PARSED)
  changeDetected   Boolean  @default(false)
  createdAt       DateTime @default(now())

  connector         SourceConnector      @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  opportunityVersions OpportunityVersion[]

  @@unique([connectorId, externalId, contentHash])
  @@index([connectorId])
  @@index([fetchedAt])
}

// ─────────────────────────────────────────────────────────
// Opportunity & Versions
// ─────────────────────────────────────────────────────────

model Opportunity {
  id                          String             @id @default(cuid())
  canonicalId                 String     @unique
  title                       String
  opportunityNumber           String?
  assistanceListingNumber     String?
  funderId                    String?
  programName                 String?
  sourceConnectorId           String?
  sourceUrl                   String?
  canonicalApplicationUrl     String?
  applicantTypes              String[]
  taxStatusRequirements       String[]
  geographicEligibility       String?
  subjectAreas                String[]
  populationsServed           String[]
  awardMin                    Decimal?  @db.Decimal(14, 2)
  awardMax                    Decimal?  @db.Decimal(14, 2)
  estimatedTotal              Decimal?  @db.Decimal(14, 2)
  costShareRequired           Boolean  @default(false)
  status                      OpportunityStatus @default(OPEN)
  openingDate                 DateTime?
  loiDate                     DateTime?
  deadline                    DateTime?
  expectedAwardDate           DateTime?
  eligibilityRules            Json?
  requiredRegistrations       String[]
  requiredAttachments         String[]
  applicationMethod          ApplicationMethod  @default(ONLINE_PORTAL)
  contactInfo                 Json?
  lastRetrievedAt             DateTime?
  lastChangedAt               DateTime?
  lastVerifiedAt              DateTime?
  provenance                  Json?
  confidence                  Decimal?   @db.Decimal(7, 4)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  funder                Funder?               @relation(fields: [funderId], references: [id], onDelete: SetNull)
  sourceConnector       SourceConnector?     @relation(fields: [sourceConnectorId], references: [id], onDelete: SetNull)
  versions              OpportunityVersion[]
  matchResults          MatchResult[]
  applications          Application[]
  requirementMatrices   RequirementMatrix[]
  savedSearches         SavedSearch[]

  @@index([status])
  @@index([funderId])
  @@index([sourceConnectorId])
  @@index([deadline])
}

model OpportunityVersion {
  id              String   @id @default(cuid())
  opportunityId    String
  versionNumber   Int
  changeType      ChangeType @default(CREATED)
  changedFields   String[]
  amendmentNotice String?
  capturedAt      DateTime @default(now())
  rawSourceRecordId String?

  opportunity     Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  rawSourceRecord RawSourceRecord? @relation(fields: [rawSourceRecordId], references: [id], onDelete: SetNull)

  @@unique([opportunityId, versionNumber])
  @@index([opportunityId])
  @@index([capturedAt])
}

// ─────────────────────────────────────────────────────────
// Funders & Historical Awards
// ─────────────────────────────────────────────────────────

model Funder {
  id                       String   @id @default(cuid())
  legalName                String
  aliases                  String[]
  ein                      String?
  funderType               FunderType @default(FOUNDATION)
  parentFunderId           String?
  website                  String?
  geographicGiving         String[]
  subjectGiving            String[]
  typicalAwardMin          Decimal?  @db.Decimal(14, 2)
  typicalAwardMax          Decimal?  @db.Decimal(14, 2)
  awardFrequency           String?
  repeatRecipientRate      Decimal? @db.Decimal(5, 4)
  newRecipientRate         Decimal? @db.Decimal(5, 4)
  applicationPreferences   Json?
  givingTrends             Json?
  keyContacts             Json?
  form990DataRef           String?
  provenance              Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  parentFunder   Funder?            @relation("FunderParentChild", fields: [parentFunderId], references: [id], onDelete: SetNull)
  subFunders     Funder[]           @relation("FunderParentChild")
  opportunities  Opportunity[]      @relation("FunderOpportunities")
  ownedOpportunities Opportunity[]   @relation("OpportunitiesByFunder")
  historicalAwards HistoricalAward[]
  savedSearches  SavedSearch[]

  @@index([legalName])
  @@index([parentFunderId])
}

model HistoricalAward {
  id              String   @id @default(cuid())
  funderId        String
  recipientName   String
  recipientEin    String?
  amount          Decimal  @db.Decimal(14, 2)
  fiscalYear      Int?
  purpose         String?
  subjectArea     String?
  geography       String?
  sourceRef       String?
  isOpenOpportunity Boolean @default(false)
  awardedAt       DateTime?
  createdAt       DateTime @default(now())

  funder Funder @relation(fields: [funderId], references: [id], onDelete: Cascade)

  @@index([funderId])
  @@index([fiscalYear])
  @@index([recipientEin])

  // Ensure historical awards are never presented as open opportunities
  // The isOpenOpportunity flag defaults to false for historical awards.
}

// ─────────────────────────────────────────────────────────
// Applicant Profiles & Matching
// ─────────────────────────────────────────────────────────

model ApplicantProfile {
  id                          String   @id @default(cuid())
  tenantId                    String
  applicantType              ApplicantType
  orgName                    String?
  ein                        String?
  taxStatus                  String?
  missionStatement           String?
  geographicServiceArea      String[]
  subjectAreas               String[]
  populationsServed          String[]
  annualBudget               Decimal?  @db.Decimal(14, 2)
  researcherInterests         String[]
  publications               Json?
  careerStage                String?
  requestedAmountRange       Json?
  registrations              String[]
  aiUsageConsent            Boolean   @default(false)
  completenessScore         Decimal?  @db.Decimal(5, 4)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matchResults MatchResult[]
  applications Application[]
  savedSearches SavedSearch[]
  documents    ProfileDocument[]

  @@index([tenantId])
}

// Uploads associated with the applicant profile (resumes, proposals, etc.)
model ProfileDocument {
  id              String   @id @default(cuid())
  applicantProfileId String
  uploadedFileRef String
  fileType        String
  fileSizeBytes   BigInt
  malwareScanStatus String @default("PENDING")
  malwareScanError String?
  uploadedAt      DateTime @default(now())

  applicantProfile ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  @@index([applicantProfileId])
}

model MatchResult {
  id                    String   @id @default(cuid())
  applicantProfileId    String
  opportunityId         String
  overallScore          Decimal   @db.Decimal(5, 4)
  eligibilityResult      String
  programRelevanceScore Decimal?  @db.Decimal(5, 4)
  competitivenessScore  Decimal?  @db.Decimal(5, 4)
  readinessScore        Decimal?  @db.Decimal(5, 4)
  factorContributions    Json?
  matchReasons          String[]
  mismatchReasons       String[]
  missingProfileFields  String[]
  disqualifyingConditions String[]
  sourceEvidence        Json?
  confidence            Decimal?  @db.Decimal(5, 4)
  recommendedAction     String?
  generatedAt           DateTime @default(now())
  createdAt             DateTime @default(now())

  applicantProfile ApplicantProfile @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)
  opportunity      Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([applicantProfileId, opportunityId])
  @@index([applicantProfileId])
  @@index([opportunityId])
  @@index([overallScore])
}

// ─────────────────────────────────────────────────────────
// Saved Searches
// ─────────────────────────────────────────────────────────

model SavedSearch {
  id                    String   @id @default(cuid())
  tenantId              String
  applicantProfileId   String?
  name                  String
  filters               Json?
  negativeKeywords      String[]
  geoRadius             Json?
  alertNewMatches       Boolean  @default(false)
  alertDeadlineChanges  Boolean  @default(false)
  lastRunAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicantProfile  ApplicantProfile?  @relation(fields: [applicantProfileId], references: [id], onDelete: SetNull)
  followedFunders   Funder[]
  followedOpportunities Opportunity[]

  @@index([tenantId])
  @@index([applicantProfileId])
}

// ─────────────────────────────────────────────────────────
// Knowledge Library
// ─────────────────────────────────────────────────────────

model KnowledgeAsset {
  id              String   @id @default(cuid())
  tenantId        String
  assetType       String
  title           String
  content         String?
  version         Int      @default(1)
  citations       Json?
  aiUsageAllowed  Boolean  @default(false)
  uploadedFileRef String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetType])
}

// ─────────────────────────────────────────────────────────
// Requirement Extraction
// ─────────────────────────────────────────────────────────

model RequirementMatrix {
  id                  String   @id @default(cuid())
  opportunityId       String
  applicationId       String?
  extractedFromRef    String?
  requirements        Json?
  charWordLimits      Json?
  evaluationCriteria  Json?
  requiredAttachments String[]
  certifications      String[]
  sourcePassages      Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  application  Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([applicationId])
}

// ─────────────────────────────────────────────────────────
// Applications & Proposal Sections
// ─────────────────────────────────────────────────────────

model Application {
  id                    String          @id @default(cuid())
  tenantId              String
  opportunityId         String
  applicantProfileId    String
  stage                ApplicationStage  @default(PROSPECT)
  assignedOwners        String[]
  submissionChecklist    Json?
  confirmationNumber    String?
  submittedAt           DateTime?
  submissionVerified   Boolean          @default(false)
  outcome               ApplicationOutcome @default(PENDING)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity         Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantProfile    ApplicantProfile   @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)
  proposalSections    ProposalSection[]
  tasks                Task[]
  requirementMatrices RequirementMatrix[]
  awardManagement     AwardManagement?

  @@index([tenantId])
  @@index([opportunityId])
  @@index([applicantProfileId])
  @@index([stage])
}

model ProposalSection {
  id                   String       @id @default(cuid())
  applicationId         String
  sectionType           String
  content               String?
  version               Int          @default(1)
  charLimit             Int?
  wordLimit             Int?
  mappedCriteria        Json?
  unsupportedClaimFlags String[]
  reusedLanguageFlags   String[]
  citations             Json?
  reviewStatus          ReviewStatus @default(DRAFT)
  comments              Json?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([reviewStatus])
}

// ─────────────────────────────────────────────────────────
// Post-Award Management
// ─────────────────────────────────────────────────────────

model AwardManagement {
  id                String   @id @default(cuid())
  applicationId     String   @unique
  awardConditions   Json?
  reportingSchedule Json?
  deliverables      Json?
  spenddown         Json?
  costShareTracked  Json?
  budgetVsActual    Json?
  renewalReminderAt DateTime?
  outcomes          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────
// Tasks
// ─────────────────────────────────────────────────────────

model Task {
  id              String     @id @default(cuid())
  tenantId        String
  applicationId   String?
  title           String
  ownerId         String?
  dependsOn       String[]
  dueDate         DateTime?
  reminderAt      DateTime?
  status          TaskStatus  @default(TODO)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([applicationId])
  @@index([status])
  @@index([dueDate])
  @@index([ownerId])
}

// ─────────────────────────────────────────────────────────
// Audit Log
// ─────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
