                for f in findings or [])
 
 
+# A single return expression: identifier / number / string / call, then
+# optional binary ops. Stops before prose ("to"), backticks, or a second
+# `return` so `change return a - b to return a + b` yields TWO statements.
+# Assessors also write "returns a - b instead of a + b" / "Returning a - b".
+_RETURN_ATOM = (
+    r"(?:f?(?:\"[^\"]*\"|'[^']*')|[A-Za-z_][A-Za-z0-9_]*|\d+|\([^)]*\))"
+)
+_RETURN_EXPR = _RETURN_ATOM + r"(?:\s*[\+\-\*/%]\s*" + _RETURN_ATOM + r")*"
+_RETURN_STMT_RX = re.compile(
+    r"\breturn(?:s|ing)?\s+" + _RETURN_EXPR, re.IGNORECASE)
+_INSTEAD_EXPR_RX = re.compile(
+    r"\binstead of\s+" + _RETURN_EXPR, re.IGNORECASE)
+
+
+def _normalize_return_stmt(stmt: str) -> str:
+    return re.sub(r"\s+", " ", str(stmt or "")).strip()
+
+
+def _finding_text_blob(findings: list) -> str:
+    parts: list[str] = []
+    for finding in findings or []:
+        if not isinstance(finding, dict):
+            continue
+        for key in ("fix", "problem", "title", "source_excerpt", "next_step",
+                    "evidence"):
+            val = str(finding.get(key) or "").strip()
+            if val:
+                parts.append(val)
+    return "\n".join(parts)
+
+
+def _apply_named_return_statement(current: str, findings: list) -> str | None:
+    """Last-resort PURPOSE apply: swap the defect return the finding named
+    for the replacement return the finding also named.
+
+    Free local authors keep emitting syntax-invalid patches (live option 4
+    2026-09-01: three ``[revert]`` rounds of ``py_compile`` failure on
+    ``hello.py``). The finding already states both sides — ``return a - b``
+    is in the file, ``return a + b`` is not. That pair is the fix; this
+    does not invent a statement.
+
+    Requires BOTH an in-file return and a not-in-file return from the
