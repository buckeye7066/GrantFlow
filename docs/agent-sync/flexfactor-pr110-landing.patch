+def _drop_stale_purpose_gaps(purpose_gap: dict | None, project_dir: str
+                             ) -> dict | None:
+    """A purpose gap that cites a defect already gone from HEAD is not open.
+
+    Live option 4 2026-09-01: qwen 3b scored 1/4 UNSTABLE after ``add()`` was
+    already ``return a + b`` and the suite was GREEN, because the assessor
+    kept re-emitting ``return a - b``. Same evidence gate as the reviewer.
+    """
+    if not purpose_gap:
+        return purpose_gap
+    gaps = list(purpose_gap.get("gaps") or [])
+    if not gaps:
+        return purpose_gap
+    haystack = _current_tree_haystack(project_dir)
+    kept: list = []
+    dropped = 0
+    for gap in gaps:
+        finding = _gap_to_finding(gap) if isinstance(gap, dict) else {}
+        evidence = str((gap or {}).get("evidence") or "").strip()
+        stale = _stale_review_finding(finding, haystack)
+        if not stale and evidence and len(evidence) >= 8 and evidence not in haystack:
+            stale = True
+        if stale:
+            dropped += 1
+            print(f"  [evidence] purpose-gap: dropped stale "
+                  f"'{str((gap or {}).get('title') or '?')[:60]}'")
+            continue
+        kept.append(gap)
+    if not dropped:
+        return purpose_gap
+    out = dict(purpose_gap)
+    out["gaps"] = kept
+    if not kept and int(out.get("criteria_total") or 0) > 0:
+        total = int(out["criteria_total"])
+        out["criteria_met"] = total
+        out["criteria_unknown"] = 0
+        out["fulfillment_pct"] = 100
+        for row in (out.get("acceptance_coverage") or []):
+            if isinstance(row, dict):
+                row["met"] = True
+                row["blocking_gaps"] = 0
+                row["unattributed_gaps"] = 0
+                row["gap_titles"] = []
+        print("  [evidence] purpose-gap: remaining gaps were stale; "
+              f"criteria {total}/{total} from the current tree")
+    return out
+
